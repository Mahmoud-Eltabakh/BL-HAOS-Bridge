#!/command/with-contenv bashio
# ==============================================================================
# BL-HAOS: S6-rc FastAPI Backend Daemon Service
# ==============================================================================

export PIPEWIRE_RUNTIME_DIR=/var/run/pipewire
export XDG_RUNTIME_DIR=/var/run/pipewire
export PYTHONPATH=/backend:$PYTHONPATH

configured_log_level="$(bashio::config 'log_level')"
case "${configured_log_level,,}" in
	trace) export LOG_LEVEL="debug" ;;
	fatal) export LOG_LEVEL="critical" ;;
	notice) export LOG_LEVEL="info" ;;
	*) export LOG_LEVEL="${configured_log_level,,}" ;;
esac

# Audio held ahead of the speaker. A link that needs more slack than the default
# (LDAC on a busy 2.4 GHz band, a slow board) can be given more here; the daemon
# validates the range and ignores anything it cannot use.
configured_buffer_ms="$(bashio::config 'playback_buffer_ms')"
if [ -n "${configured_buffer_ms}" ] && [ "${configured_buffer_ms}" != "null" ]; then
	export BLHAOS_PLAYBACK_BUFFER_MS="${configured_buffer_ms}"
fi

echo "[bl-haos-daemon] Starting FastAPI backend daemon on port 8099..."

# uvicorn closes an idle keep-alive connection after 5 seconds by default, while
# Home Assistant's shared aiohttp session keeps pooled sockets for longer. The
# client then reuses a socket this daemon has just closed, which reached the user
# as "Failed to play_media: Server disconnected". Staying open longer than any
# client pool means the client always retires the socket first.
uvicorn_keep_alive_seconds="${UVICORN_KEEP_ALIVE_SECONDS:-75}"

exec python3 -m uvicorn bl_haos.main:app --host 0.0.0.0 --port 8099 \
    --timeout-keep-alive "${uvicorn_keep_alive_seconds}" --log-level "${LOG_LEVEL}"
